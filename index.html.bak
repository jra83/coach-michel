<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Coach Michel — Interface Complète</title>
<style>
  :root{
    --bg:#0f1115; --panel:#171a21; --ink:#e7ebf0; --mut:#8b95a5;
    --line:#252a33; --accent:#fc5200; --accent2:#3aa0ff; --good:#34d399;
    --warn:#f59e0b; --err:#ef4444;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    padding:20px;min-height:100vh}
  .wrap{max-width:900px;margin:0 auto}
  h1{font-size:24px;font-weight:650;margin:0 0:8px;letter-spacing:-.3px}
  .sub{color:var(--mut);font-size:14px;margin:0 0:24px}
  .nav{display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap}
  .nav button{background:var(--panel);color:var(--ink);border:1px solid var(--line);
    padding:8px 16px;border-radius:20px;font-size:14px;cursor:pointer;transition:all .2s}
  .nav button:hover{border-color:var(--accent)}
  .nav button.active{background:var(--accent);color:#fff;border-color:var(--accent)}
  .section{display:none}
  .section.active{display:block}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;margin-bottom:24px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px}
  .k{font-size:12px;color:var(--mut);margin-bottom:8px;line-height:1.4}
  .v{font-size:26px;font-weight:700;letter-spacing:-.5px}
  .v small{font-size:14px;font-weight:500;color:var(--mut)}
  .legend{display:flex;gap:16px;font-size:13px;color:var(--mut);margin:8px 0:12px}
  svg{background:var(--panel);border:1px solid var(--line);border-radius:12px;margin-bottom:20px}
  .axis{font-family:monospace;font-size:11px}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:20px}
  .plan-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(100px,1fr));gap:12px}
  .plan-day{background:var(--line);border-radius:8px;padding:12px;cursor:pointer;transition:all .2s}
  .plan-day:hover{border:1px solid var(--accent)}
  .plan-day.done{opacity:.6}
  .plan-day .day{font-size:12px;color:var(--mut);margin-bottom:4px}
  .plan-day .name{font-weight:600;margin-bottom:6px}
  .plan-day .type{font-size:11px;color:var(--accent);margin-bottom:4px}
  .workout-item{display:flex;gap:12px;padding:12px;background:var(--line);border-radius:8px;margin-bottom:8px}
  .workout-date{font-size:11px;color:var(--mut);min-width:90px}
  .workout-info{flex:1}
  .workout-info .name{font-weight:600;margin-bottom:4px}
  .workout-info .meta{font-size:12px;color:var(--mut)}
  .chat-input{width:100%;background:var(--panel);color:var(--ink);
    border:1px solid var(--line);border-radius:20px;padding:12px 16px;margin-top:16px;
    font-family:inherit}
  .chat-btn{background:var(--accent);color:#fff;border:none;
    border-radius:20px;padding:12px 24px;cursor:pointer;margin-top:8px}
  .chat-messages{margin-top:16px}
  .chat-msg{background:var(--line);padding:12px;border-radius:12px;margin-bottom:8px}
  .chat-msg .role{font-size:11px;color:var(--accent);margin-bottom:4px}
  .modal{position:fixed;top:0;left:0;right:0;bottom:0;
    background:rgba(0,0,0,.7);display:none;align-items:center;justify-content:center;z-index:1000}
  .modal.open{display:flex}
  .modal-content{background:var(--panel);padding:24px;border-radius:12px;max-width:500px;width:90%;max-height:80vh;overflow-y:auto}
  .modal-close{position:absolute;top:16px;right:16px;
    background:none;border:none;color:var(--ink);font-size:24px;cursor:pointer}
</style>
</head>
<body>
<div class="wrap">
  <h1>Coach Michel</h1>
  <p class="sub">Dashboard d'entraînement — Strava + métriques</p>
  
  <nav class="nav">
    <button class="active" data-section="dashboard">Tableau de bord</button>
    <button data-section="metrics">Métriques & Dérives</button>
    <button data-section="plan">Plan</button>
    <button data-section="data">Données corporelles</button>
    <button data-section="chat">Chat Coach</button>
  </nav>

  <!-- DASHBOARD -->
  <div id="dashboard" class="section active">
    <div class="cards">
      <div class="card">
        <div class="k">Charge actuelle</div>
        <div class="v"><span id="week-load">—</span></div>
      </div>
      <div class="card">
        <div class="k">Marge disponible</div>
        <div class="v"><span id="margin">—</span></div>
      </div>
      <div class="card">
        <div class="k">Statut</div>
        <div class="v"><span id="fitness-status">—</span></div>
      </div>
      <div class="card">
        <div class="k">Recommandation</div>
        <div class="v"><span id="fitness-rec">—</span></div>
      </div>
    </div>
    <svg id="fitness-chart" viewBox="0 0 820 180"></svg>
    <div class="panel">
      <h3>Volume hebdo</h3>
      <div class="legend"><span style="color:var(--accent)">● km</span> <span style="color:var(--accent2)">● D+</span></div>
      <svg id="weekly-chart" viewBox="0 0 820 230"></svg>
    </div>
    <div class="panel">
      <h3>Volume annuel</h3>
      <svg id="yearly-chart" viewBox="0 0 820 260"></svg>
    </div>
  </div>

  <!-- METRICS -->
  <div id="metrics" class="section">
    <div class="panel">
      <h3>Évolution vitesse par zone FC</h3>
      <svg id="pace-chart" viewBox="0 0 820 200"></svg>
    </div>
    <div class="panel">
      <h3>Dérive cardiaque</h3>
      <svg id="hrdrift-chart" viewBox="0 0 820 200"></svg>
    </div>
  </div>

  <!-- PLAN -->
  <div id="plan" class="section">
    <div class="panel">
      <h3>Plan cette semaine</h3>
      <div id="plan-grid" class="plan-grid"></div>
    </div>
  </div>

  <!-- DATA -->
  <div id="data" class="section">
    <div class="panel">
      <h3>Données corporelles</h3>
      <svg id="body-chart" viewBox="0 0 820 200"></svg>
    </div>
  </div>

  <!-- CHAT -->
  <div id="chat" class="section">
    <div class="panel">
      <h3>Chat avec Coach Michel</h3>
      <div id="chat-messages" class="chat-messages"></div>
      <input type="text" id="chat-input" class="chat-input" placeholder="Pose ta question...">
      <button class="chat-btn" onclick="sendChat()">Envoyer</button>
    </div>
  </div>
</div>

<!-- Modal plan detail -->
<div id="plan-modal" class="modal">
  <div class="modal-content">
    <button class="modal-close" onclick="closeModal()">×</button>
    <h3 id="modal-title"></h3>
    <div id="modal-content"></div>
  </div>
</div>

<script>
// Données chargées depuis l'API
window.D = {
  years:[],
  vol:[],
  weeks:[],
  workouts:[],
  plan:[],
  body:[],
  paceEvolution:[],
  hrDrift:[],
  fitness:{ctl:0,atl:0,tsb:0,limit:55,weekLoad:0,history:[]}
};

const D = window.D;

// Charger les données depuis l'API
async function loadData(){
  try{
    // Afficher indicateur de chargement
    document.querySelectorAll('svg').forEach(svg=>svg.innerHTML='<text x="410" y="100" text-anchor="middle" fill="var(--mut)">Chargement...</text>');
    
    // État de forme
    const fitnessRes=await fetch('/api/fitness');
    const fitnessData=await fitnessRes.json();
    D.fitness=fitnessData;
    
    // Volume hebdo
    const weeklyRes=await fetch('/api/weekly-volume');
    D.weeks=await weeklyRes.json();
    
    // Volume annuel
    const yearlyRes=await fetch('/api/yearly-volume');
    const yearlyData=await yearlyRes.json();
    D.years=yearlyData.years;
    D.vol=yearlyData.vol;
    
    // Dernières sorties
    const workoutsRes=await fetch('/api/workouts/recent');
    D.workouts=await workoutsRes.json();
    
    // Plan
    const planRes=await fetch('/api/plan');
    const planData=await planRes.json();
    D.plan=planData.plan;
    
    // Données corporelles (placeholder)
    D.body=[
      {date:'2026-01-01',weight:83.3,fat:15.3,muscle:64.5,water:47.0},
      {date:'2026-03-01',weight:82.4,fat:14.4,muscle:64.5,water:46.8},
      {date:'2026-06-19',weight:81.4,fat:13.4,muscle:64.6,water:47.2}
    ];
    
    // Évolution vitesse
    D.paceEvolution=[
      {date:'2026-01',z1:6.8,z2:6.0,z3:5.2,z4:4.8},
      {date:'2026-03',z1:6.5,z2:5.8,z3:5.0,z4:4.6},
      {date:'2026-06',z1:6.2,z2:5.5,z3:4.8,z4:4.4}
    ];
    
    // Dérive cardiaque
    D.hrDrift=[
      {date:'2026-06-01',start:142,end:148,drift:4.2},
      {date:'2026-06-15',start:145,end:154,drift:6.2},
      {date:'2026-06-21',start:150,end:158,drift:5.3}
    ];
    
    // Re-rendre après chargement
    renderAll();
  }catch(e){
    console.error('Erreur chargement données',e);
    document.querySelectorAll('svg').forEach(svg=>svg.innerHTML='<text x="410" y="100" text-anchor="middle" fill="var(--err)">Erreur de chargement</text>');
  }
}

function renderAll(){
  renderFitness();
  drawWeeklyChart();
  drawYearlyChart();
  drawPaceDriftChart();
  drawHrDriftChart();
  drawBodyChart();
  renderPlan();
  renderWorkouts();
  renderChat();
}

// Navigation
function initNav(){
  document.querySelectorAll('.nav button').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(btn.dataset.section).classList.add('active');
    });
  });
}

// État de forme
function renderFitness(){
  if(!D.fitness||!D.fitness.ctl){
    document.getElementById('ctl-val').textContent='-';
    document.getElementById('atl-val').textContent='-';
    document.getElementById('tsb-val').textContent='-';
    document.getElementById('limit-val').textContent='-';
    document.getElementById('week-load').innerHTML='<small>—</small>';
    document.getElementById('margin').innerHTML='<small>—</small>';
    document.getElementById('fitness-status').textContent='—';
    document.getElementById('fitness-rec').textContent='—';
    document.getElementById('fitness-chart').innerHTML='<text x="410" y="90" text-anchor="middle" fill="var(--mut)">Pas de données</text>';
    return;
  }
  const f=D.fitness;
  document.getElementById('ctl-val').textContent=f.ctl;
  document.getElementById('atl-val').textContent=f.atl;
  document.getElementById('tsb-val').textContent=f.tsb;
  document.getElementById('limit-val').textContent=f.limit;
  document.getElementById('week-load').innerHTML=f.weekLoad+'<small> km/sem</small>';
  document.getElementById('margin').innerHTML=(f.limit-f.weekLoad).toFixed(1)+'<small> km</small>';
  document.getElementById('fitness-status').textContent=f.tsb>=0?'OK':'Fatigue';
  const rec=f.tsb>=0?'Maintenir':'Réduire';
  document.getElementById('fitness-rec').textContent=rec;
  
  // Graphique évolution CTL/ATL/TSB sur 12 semaines
  const w=820,h=180,L=40,R=30,T=14,B=24,iw=w-L-R,ih=h-T-B;
  const max=50;
  let s=`<line x1="${L}" y1="${T+ih}" x2="${w-R}" y2="${T+ih}" stroke="var(--line)"/>`;
  [0,10,20,30,40,50].forEach(g=>{const y=T+ih-g/max*ih;
    s+=`<line x1="${L}" y1="${y}" x2="${w-R}" y2="${y}" stroke="var(--line)" stroke-dasharray="2 4"/>`;
    s+=`<text class="axis" x="${L-6}" y="${y+3}" text-anchor="end" fill="var(--mut)">${g}</text>`;});
  
  const hist=f.history,n=hist.length,gap=iw/(n-1);
  
  // CTL (bleu)
  let ctlPts=hist.map((d,i)=>{const x=L+gap*i,y=T+ih-d.ctl/max*ih;return [x,y];});
  s+=`<polyline fill="none" stroke="var(--accent2)" stroke-width="2.5" points="${ctlPts.map(p=>p.join(',')).join(' ')}"/>`;
  ctlPts.forEach(p=>s+=`<circle cx="${p[0]}" cy="${p[1]}" r="2.5" fill="var(--accent2)"/>`);
  
  // ATL (orange)
  let atlPts=hist.map((d,i)=>{const x=L+gap*i,y=T+ih-d.atl/max*ih;return [x,y];});
  s+=`<polyline fill="none" stroke="var(--warn)" stroke-width="2.5" points="${atlPts.map(p=>p.join(',')).join(' ')}"/>`;
  atlPts.forEach(p=>s+=`<circle cx="${p[0]}" cy="${p[1]}" r="2.5" fill="var(--warn)"/>`);
  
  // TSB (vert)
  let tsbPts=hist.map((d,i)=>{const x=L+gap*i,y=T+ih-d.tsb/max*ih;return [x,y];});
  s+=`<polyline fill="none" stroke="var(--good)" stroke-width="2" points="${tsbPts.map(p=>p.join(',')).join(' ')}"/>`;
  tsbPts.forEach(p=>s+=`<circle cx="${p[0]}" cy="${p[1]}" r="2" fill="var(--good)"/>`;
  
  // Limite (rouge)
  const limY=T+ih-f.limit/max*ih;
  s+=`<line x1="${L}" y1="${limY}" x2="${w-R}" y2="${limY}" stroke="var(--err)" stroke-width="1.5" stroke-dasharray="4 4"/>`;
  s+=`<text class="axis" x="${w-R+6}" y="${limY+3}" text-anchor="start" fill="var(--err)" font-size="10">Limite</text>`;
  
  // Labels semaines
  hist.forEach((d,i)=>{const x=L+gap*i;
    s+=`<text class="axis" x="${x}" y="${T+ih+16}" text-anchor="middle" fill="var(--mut)" font-size="10">S${d.week}</text>`;});
  
  // Légende
  s+=`<text class="axis" x="${L}" y="${T-4}" fill="var(--accent2)" font-size="11">CTL</text>`;
  s+=`<text class="axis" x="${L+35}" y="${T-4}" fill="var(--warn)" font-size="11">ATL</text>`;
  s+=`<text class="axis" x="${L+70}" y="${T-4}" fill="var(--good)" font-size="11">TSB</text>`;
  
  document.getElementById('fitness-chart').innerHTML=s;
}

// Graphique hebdo
function drawWeeklyChart(){
  if(!D.weeks||D.weeks.length===0){
    document.getElementById('weekly-chart').innerHTML='<text x="410" y="115" text-anchor="middle" fill="var(--mut)">Pas de données</text>';
    return;
  }
  const w=820,h=230,L=34,R=40,T=14,B=28,iw=w-L-R,ih=h-T-B;
  const wk=D.weeks,n=wk.length,gap=iw/n,bw=gap*0.5;
  const kmMax=70,dMax=3600;
  let s=`<line x1="${L}" y1="${T+ih}" x2="${w-R}" y2="${T+ih}" stroke="var(--line)"/>`;
  [0,20,40,60].forEach(g=>{const y=T+ih-g/kmMax*ih;
    s+=`<line x1="${L}" y1="${y}" x2="${w-R}" y2="${y}" stroke="var(--line)" stroke-dasharray="2 4"/>`;
    s+=`<text class="axis" x="${L-6}" y="${y+3}" text-anchor="end" fill="var(--mut)">${g}</text>`;});
  wk.forEach((d,i)=>{const x=L+gap*i+(gap-bw)/2,bh=d.km/kmMax*ih,y=T+ih-bh;
    s+=`<rect x="${x}" y="${y}" width="${bw}" height="${bh}" rx="2.5" fill="var(--accent)"/>`;
    s+=`<text class="axis" x="${x+bw/2}" y="${T+ih+15}" text-anchor="middle" fill="var(--mut)">S${d.s}</text>`;});
  let pts=wk.map((d,i)=>{const x=L+gap*i+gap/2,y=T+ih-d.dplus/dMax*ih;return [x,y];});
  s+=`<polyline fill="none" stroke="var(--accent2)" stroke-width="2" points="${pts.map(p=>p.join(',')).join(' ')}"/>`;
  pts.forEach(p=>s+=`<circle cx="${p[0]}" cy="${p[1]}" r="2.6" fill="var(--accent2)"/>`);
  [0,1800,3600].forEach(g=>{const y=T+ih-g/dMax*ih;
    s+=`<text class="axis" x="${w-R+6}" y="${y+3}" text-anchor="start" fill="var(--accent2)">${g}</text>`;});
  document.getElementById('weekly-chart').innerHTML=s;
}

// Graphique annuel
function drawYearlyChart(){
  if(!D.years||D.years.length===0){
    document.getElementById('yearly-chart').innerHTML='<text x="410" y="130" text-anchor="middle" fill="var(--mut)">Pas de données</text>';
    return;
  }
  const w=820,h=260,L=38,R=12,T=14,B=34,iw=w-L-R,ih=h-T-B;
  const yr=D.years,n=yr.length,gap=iw/n,bw=gap*0.5;
  const vMax=1200;
  let s=`<line x1="${L}" y1="${T+ih}" x2="${w-R}" y2="${T+ih}" stroke="var(--line)"/>`;
  [0,400,800,1200].forEach(g=>{const y=T+ih-g/vMax*ih;
    s+=`<line x1="${L}" y1="${y}" x2="${w-R}" y2="${y}" stroke="var(--line)" stroke-dasharray="2 4"/>`;
    s+=`<text class="axis" x="${L-6}" y="${y+3}" text-anchor="end" fill="var(--mut)">${g}</text>`;});
  yr.forEach((y,i)=>{const x=L+gap*i+(gap-bw)/2,bh=D.vol[i]/vMax*ih,yy=T+ih-bh;
    s+=`<rect x="${x}" y="${yy}" width="${bw}" height="${bh}" rx="2.5" fill="var(--accent)"/>`;
    s+=`<text class="axis" x="${x+bw/2}" y="${T+ih+15}" text-anchor="middle" fill="var(--mut)">${y}</text>`;});
  document.getElementById('yearly-chart').innerHTML=s;
}

// Graphique évolution vitesse par zone
function drawPaceDriftChart(){
  if(!D.paceEvolution||D.paceEvolution.length===0){
    return;
  }
  const w=820,h=200,L=60,R=30,T=14,B=30,iw=w-L-R,ih=h-T-B;
  const pe=D.paceEvolution,n=pe.length,gap=iw/(n-1);
  const pMin=4,pMax=7;
  let s=`<line x1="${L}" y1="${T+ih}" x2="${w-R}" y2="${T+ih}" stroke="var(--line)"/>`;
  [4,5,6,7].forEach(g=>{const y=T+ih-(g-pMin)/(pMax-pMin)*ih;
    s+=`<line x1="${L}" y1="${y}" x2="${w-R}" y2="${y}" stroke="var(--line)" stroke-dasharray="2 4"/>`;
    s+=`<text class="axis" x="${L-6}" y="${y+3}" text-anchor="end" fill="var(--mut)">${g}:00</text>`;});
  [['z1',pe[0]?.z1,'#3aa0ff'],['z2',pe[0]?.z2,'#f59e0b'],['z3',pe[0]?.z3,'#fc5200'],['z4',pe[0]?.z4,'#ef4444']].forEach(([k,v,c])=>{
    let pts=pe.map((d,i)=>{const x=L+gap*i,y=T+ih-(d[k]-pMin)/(pMax-pMin)*ih;return [x,y];});
    s+=`<polyline fill="none" stroke="${c}" stroke-width="2" points="${pts.map(p=>p.join(',')).join(' ')}"/>`;
    pts.forEach(p=>s+=`<circle cx="${p[0]}" cy="${p[1]}" r="2.5" fill="${c}"/>`);
  });
  pe.forEach((d,i)=>{const x=L+gap*i;
    s+=`<text class="axis" x="${x}" y="${T+ih+16}" text-anchor="middle" fill="var(--mut)">${d.date}</text>`;});
  document.getElementById('pace-chart').innerHTML=s;
}

// Graphique dérive cardiaque
function drawHrDriftChart(){
  if(!D.hrDrift||D.hrDrift.length===0){
    return;
  }
  const w=820,h=200,L=34,R=40,T=14,B=30,iw=w-L-R,ih=h-T-B;
  const hd=D.hrDrift,n=hd.length,gap=iw/n,bw=gap*0.4;
  const driftMax=8;
  let s=`<line x1="${L}" y1="${T+ih}" x2="${w-R}" y2="${T+ih}" stroke="var(--line)"/>`;
  [0,4,8].forEach(g=>{const y=T+ih-g/driftMax*ih;
    s+=`<line x1="${L}" y1="${y}" x2="${w-R}" y2="${y}" stroke="var(--line)" stroke-dasharray="2 4"/>`;
    s+=`<text class="axis" x="${L-6}" y="${y+3}" text-anchor="end" fill="var(--mut)">${g}%</text>`;});
  hd.forEach((d,i)=>{const x=L+gap*i+(gap-bw)/2,bh=d.drift/driftMax*ih,y=T+ih-bh;
    const col=d.drift<5?'var(--good)':d.drift<7?'var(--warn)':'var(--err)';
    s+=`<rect x="${x}" y="${y}" width="${bw}" height="${bh}" rx="2.5" fill="${col}"/>`;
    s+=`<text class="axis" x="${x+bw/2}" y="${T+ih+16}" text-anchor="middle" fill="var(--mut)">${d.date}</text>`;});
  document.getElementById('hrdrift-chart').innerHTML=s;
}

// Graphique corporel
function drawBodyChart(){
  if(!D.body||D.body.length===0){
    return;
  }
  const w=820,h=200,L=40,R=30,T=14,B=24,iw=w-L-R,ih=h-T-B;
  const bd=D.body,n=bd.length,gap=iw/n;
  const wMax=84,wMin=81,fMax=16,fMin=13;
  let s=`<line x1="${L}" y1="${T+ih}" x2="${w-R}" y2="${T+ih}" stroke="var(--line)"/>`;
  [81,82,83,84].forEach(g=>{const y=T+ih-(g-wMin)/(wMax-wMin)*ih;
    s+=`<line x1="${L}" y1="${y}" x2="${w-R}" y2="${y}" stroke="var(--line)" stroke-dasharray="2 4"/>`;
    s+=`<text class="axis" x="${L-6}" y="${y+3}" text-anchor="end" fill="var(--mut)">${g}kg</text>`;});
  let wpts=bd.map((d,i)=>{const x=L+gap*i+gap/2,y=T+ih-(d.weight-wMin)/(wMax-wMin)*ih;return [x,y];});
  s+=`<polyline fill="none" stroke="var(--accent)" stroke-width="2" points="${wpts.map(p=>p.join(',')).join(' ')}"/>`;
  wpts.forEach(p=>s+=`<circle cx="${p[0]}" cy="${p[1]}" r="2.5" fill="var(--accent)"/>`);
  bd.forEach((d,i)=>{const x=L+gap*i+gap/2;
    s+=`<text class="axis" x="${x}" y="${T+ih+16}" text-anchor="middle" fill="var(--mut)">${d.date}</text>`;});
  [13,14,15,16].forEach(g=>{const y=T+ih-(g-fMin)/(fMax-fMin)*ih;
    s+=`<text class="axis" x="${w-R+6}" y="${y+3}" text-anchor="start" fill="var(--accent2)">${g}%</text>`;});
  document.getElementById('body-chart').innerHTML=s;
}

// Plan
function renderPlan(){
  if(!D.plan||D.plan.length===0){
    return;
  }
  const grid=document.getElementById('plan-grid');
  grid.innerHTML=D.plan.map((d,i)=>`<div class="plan-day ${d.done?'done':''}" onclick="showPlanDetail(${i})">
    <div class="day">${d.day}</div>
    <div class="name">${d.name}</div>
    <div class="type">${d.type}</div>
  </div>`).join('');
}

function showPlanDetail(idx){
  const d=D.plan[idx];
  document.getElementById('modal-title').textContent=`${d.day} — ${d.name}`;
  document.getElementById('modal-content').innerHTML=`
    <p><strong>Type:</strong> ${d.type}</p>
    <p><strong>Distance:</strong> ${d.dist} km</p>
    <p><strong>Durée:</strong> ${d.dur} min</p>
    <p><strong>Allure:</strong> ${d.pace}</p>
    <p><strong>Description:</strong> ${d.desc}</p>
    <p><strong>Zones FC:</strong> Z1:${d.zones.z1}% Z2:${d.zones.z2}% Z3:${d.zones.z3}% Z4:${d.zones.z4}% Z5:${d.zones.z5}%</p>
  `;
  document.getElementById('plan-modal').classList.add('open');
}

function closeModal(){
  document.getElementById('plan-modal').classList.remove('open');
}

// Workouts
function renderWorkouts(){
  if(!D.workouts||D.workouts.length===0){
    return;
  }
  const container=document.querySelector('#dashboard');
  const panel=document.createElement('div');
  panel.className='panel';
  panel.innerHTML='<h3>Dernières sorties</h3>';
  const list=document.createElement('div');
  list.innerHTML=D.workouts.map(w=>`<div class="workout-item">
    <div class="workout-date">${w.date}</div>
    <div class="workout-info">
      <div class="name">${w.name}</div>
      <div class="meta">${w.dist}km • ${Math.floor(w.time/60)}:${(w.time%60).toString().padStart(2,'0')} • ${w.dplus}D+ • FCavg ${w.fcavg} • FCmax ${w.fcmax}</div>
    </div>
  </div>`).join('');
  panel.appendChild(list);
  container.appendChild(panel);
}

// Chat
function renderChat(){
  const container=document.getElementById('chat-messages');
  container.innerHTML=`
    <div class="chat-msg"><div class="role">Coach Michel</div><div>Bonjour ! Je suis ton coach IA. Pose-moi tes questions sur ton entraînement.</div></div>
  `;
}

function sendChat(){
  const input=document.getElementById('chat-input');
  const msg=input.value.trim();
  if(!msg)return;
  const container=document.getElementById('chat-messages');
  container.innerHTML+=`<div class="chat-msg"><div class="role">Toi</div><div>${msg}</div></div>`;
  input.value='';
  // Simuler réponse
  setTimeout(()=>container.innerHTML+=`<div class="chat-msg"><div class="role">Coach Michel</div><div>Je vais analyser tes données et te répondre...</div></div>`,1000);
}

// Init
document.addEventListener('DOMContentLoaded', function(){
  initNav();
  loadData();
});
</script>
</body>
</html>